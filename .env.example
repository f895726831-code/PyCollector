# Application
APP_NAME=my-collector-app
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (SQLite for local dev; use PostgreSQL URL for production)
DATABASE_URL=sqlite+pysqlite:///./local_dev.db

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_SECONDS=60
SCHEDULER_WEEKLY_DAY=MONDAY
SCHEDULER_WEEKLY_HOUR=9
SCHEDULER_WEEKLY_MINUTE=0
SCHEDULER_MAX_RETRY_COUNT=1
SCHEDULER_RETRY_INTERVAL_SECONDS=60

# HTTP
COLLECTOR_HTTP_TIMEOUT_SECONDS=30